DATABASE_URL=postgres://lounge:lounge@localhost:5432/lounge_base
BLOB_READ_WRITE_TOKEN=

SMTP_URL=
# Must be a domain this deployment actually controls. Once SMTP_URL is set,
# createMailer() throws if this is empty rather than defaulting to a
# placeholder — a placeholder domain fails SPF/DKIM at the receiving server,
# so mail sent from it is likely to be silently dropped or spam-foldered.
MAIL_FROM=
APP_URL=http://localhost:3000

# Set to "true" only on a machine you trust (e.g. your own laptop) to print
# full email bodies to the console fallback below — including working
# single-use links, like the sign-in mail's magic link. Leave this unset
# everywhere else: the console fallback runs whenever SMTP_URL is empty,
# and a deployment that simply forgot to configure SMTP should not also
# leak live credentials into whatever collects its logs.
MAIL_CONSOLE_SHOW_BODY=
